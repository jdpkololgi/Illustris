    "validation_and_selection": "ph006",
    "sealed_blind_test": "ph001"
  },
  "conditioning": {
    "view": "V_final R1 random-response BRIGHT-only",
    "channels": ["counts", "derived_density_proxy", "exposure_apodized_random"],
    "response_is_conditioning_not_target": true,
    "phase_is_model_input": false,
    "hod_is_model_input": false,
    "fixed_hod_condition": "H_fid"
  },
  "target": {
    "field": "delta_R7=lambda1+lambda2+lambda3",
