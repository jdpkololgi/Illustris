{
  "schema_version": "p12f-conditional-field-flow-canary-v1",
  "experiment_version": "P12-F1b optimization corrective v2",
  "status": "bounded_validation_corrective_not_production",
  "motivation": "Test whether the registered v1 undercoverage and low posterior-mean accuracy are primarily a 1000-update/320-core underfit, without changing model, solver, draws, diagnostics, gates, or ph006 rows.",
  "estimand": "p(delta_R7 patch | BGS_BRIGHT final view, random-derived response, H_fid)",
  "roles": {
