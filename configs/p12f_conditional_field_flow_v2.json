    "input_channels": 5,
    "unet_base": 8,
    "output_channels": 1,
    "base_distribution": "iid standard normal in standardized delta_R7 coordinates",
    "path": "x_t=(1-t)epsilon+t*delta; target_velocity=delta-epsilon",
    "time_conditioning": "broadcast scalar channel",
    "ode_solver": "fixed-step Heun"
  },
  "canary": {
    "training_cores_per_phase": 512,
    "nested_reference_training_cores_per_phase": 64,
    "target_scaler_cores_per_phase": 64,
    "validation_cores": 16,
    "updates": 10000,
    "seed": 42,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "gradient_clip": 5.0,
    "posterior_draws": 16,
    "ode_steps": 12,
    "maximum_saved_voxels_per_core": 4096
  },
  "primary_gates": {
    "all_finite": true,
    "checkpoint_reload": true,
    "ph001_opened": false,
    "voxel_68_coverage_absolute_error_maximum": 0.12,
    "voxel_rank_cdf_maximum_deviation": 0.12,
    "lambda_68_coverage_absolute_error_maximum": 0.15,
    "posterior_width_positive_fraction_minimum": 0.99
  },
  "frozen_comparison": {
    "same_validation_core_selection": true,
    "same_posterior_draws": true,
    "same_ode_steps": true,
    "same_scientific_gates": true,
    "only_intended_changes": [
