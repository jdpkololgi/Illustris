  "selection_gates": {
    "tarp": 0.05,
    "tarp_reference_seed_p90": 0.06,
    "global_coverage": 0.05,
    "conditional_coverage": 0.10,
    "joint_improvement": 0.02,
    "joint_improvement_interval_excludes_zero": true,
    "other_score_worsening": 0.01
