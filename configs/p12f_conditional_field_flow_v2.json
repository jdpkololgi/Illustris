      "optimizer updates: 1000 to 10000",
      "target scaler uses the exact same 64 cores per phase as v1"
    ]
  },
  "diagnostics_not_promotion_gates": [
    "posterior-mean R2(delta_R7)",
    "posterior-mean RMSE(delta_R7)",
    "local-periodic-patch derived eigenvalue accuracy"
