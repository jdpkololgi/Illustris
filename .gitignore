# ──────────────────────────────────────────────────────────────────────
# Illustris / TNG repo .gitignore
# Rule of thumb: TRACK source, configs, docs, small fixtures.
#                IGNORE generated artifacts, large data, logs, secrets, cruft.
# Force-track an exception with:  git add -f <path>
# ──────────────────────────────────────────────────────────────────────

# OS / editor cruft
.DS_Store
._*
.ipynb_checkpoints/
.vscode/

# Python
__pycache__/
*.pyc
*.pyo

# Secrets / local environment (never commit)
.env
*.key
*.pem

# Large simulation & catalog data (lives on scratch/CFS, not in git)
TNG300-1/
python/illustris_python/
*.hdf5
*.h5
*.fits
*.npy
*.npz
*.csv

# Model weights, graph caches, pickled artifacts
*.pkl
*.pth
*.pt

# Figures / rendered outputs
*.png
*.pdf
*.gif
*.html

# Run logs & generated output / plot directories
*.log
logs/
**/logs/
sbi-logs/
**/sbi_outputs/
**/sbi_plots_*/

# Generated run reports
*_report_*.txt

# Local scratch / experiments — keep throwaway run scripts here, off the remote
scratch/
sandbox/

# Retired areas — hidden from git; delete the files on disk whenever you're ready
archive/
legacy/
to-delete/
