    "primary_method": "gaussian_correlated_g1",
    "nested_draw_counts": [64, 128, 256],
    "disjoint_subpanels": 4,
    "cores_per_subpanel": 256,
    "tarp_reference_seeds": 20,
    "core_bootstrap_replicates": 4000,
    "retain_full_draws_for_all_cores": true,
    "ph001_opened": false
  },
  "methods": {
    "gaussian_independent_g0": {
      "objective": "voxelwise heteroscedastic Gaussian NLL",
